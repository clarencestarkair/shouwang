# ============================================================
# 守望 · 环境变量模板（复制为 .env.local 后填写）
# 所有模型均通过 OpenAI 兼容协议接入，可自由切换服务商。
# ============================================================

# —— 文本大模型（Agent 规划 / 工具调用 / 报告生成）——
# 通义千问（默认）：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1      模型 deepseek-chat
# 智谱：https://open.bigmodel.cn/api/paas/v4  模型 glm-4-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# 部分模型（如 Claude Opus 5.x）不接受 temperature 参数时设为 false
LLM_SUPPORTS_TEMPERATURE=true

# —— 向量模型（RAG 语义检索），设为 none 可关闭向量通道，仅用 BM25 ——
EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
