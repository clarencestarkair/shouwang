{
  "name": "shouwang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"mcp-server/**/*.ts\"",
    "rag:build": "tsx scripts/build-index.ts",
    "mcp": "tsx mcp-server/stdio.ts",
    "eval": "tsx scripts/eval-rules.ts",
    "test": "tsx --test tests/*.test.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "prestart": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cp -r data .next/standalone/ && (cp .env.local .next/standalone/ 2>/dev/null || true)"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.93",
    "@ai-sdk/react": "3.0.335",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "6.0.332",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "1.9.2",
    "jsqr": "1.4.0",
    "lucide-react": "1.74.0",
    "motion": "14.14.0",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "守望：面向银发群体的多模态反诈守护 Agent",
  "engines": {
    "node": ">=20.12"
  }
}
